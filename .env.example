# Email (nodemailer SMTP)
# IMPORTANT for Gmail / Google Workspace:
#   - Port 465 → SMTP_SECURE=true  (implicit SSL)
#   - Port 587 → SMTP_SECURE=false (STARTTLS — Gmail rejects 587+secure=true)
# Use an App Password (not the account password) for SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@cgbindia.com
SMTP_PASS=ymplrlmcykapgkrl
EMAIL_FROM="AnytimeHire <noreply@anytimehire.ai>"

# Admin address that receives a copy of every booking.
# Defaults to info@anytimehire.ai if unset.
LEAD_TO_EMAIL=info@anytimehire.ai

# Google Calendar + Meet (creates the demo event and auto-generates a Meet link)
# Setup:
# 1. Google Cloud Console → create / pick a project → enable "Google Calendar API".
# 2. IAM & Admin → Service Accounts → create one → Keys → "Add Key" → JSON.
#    Either paste the raw JSON into GOOGLE_SERVICE_ACCOUNT_JSON, or base64-encode
#    it first (handy on hosts that strip newlines from env values).
# 3. Open the target Google Calendar (e.g. info@anytimehire.ai), share it with
#    the service account's client_email, and grant "Make changes to events".
# 4. Set GOOGLE_CALENDAR_ID to the calendar id (usually the account's email).
# 5. In the host account's Meet settings, ensure "Host management" is OFF so
#    guests can join the Meet room without waiting for the host.
#
# If these are left empty, bookings still save and the .ics invite still goes
# out via SMTP — you just won't get an auto-generated Meet link.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=info@anytimehire.ai

# Booking config
BOOKING_TIMEZONE=Asia/Kolkata
BOOKING_BUFFER_MINUTES=15
