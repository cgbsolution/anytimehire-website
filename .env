# Email (nodemailer SMTP)
# IMPORTANT for Gmail / Google Workspace:
#   - Port 465 → SMTP_SECURE=true  (implicit SSL)
#   - Port 587 → SMTP_SECURE=false (STARTTLS — Gmail rejects 587+secure=true)
# Use an App Password (not the account password) for SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@cgbindia.com
SMTP_PASS=ymplrlmcykapgkrl
EMAIL_FROM="AnytimeHire <noreply@anytimehire.ai>"

# Admin address that receives a copy of every booking.
# Defaults to info@anytimehire.ai if unset.
LEAD_TO_EMAIL=info@anytimehire.ai

# Outlook + Teams (primary). Activates when all four MICROSOFT_* vars are set.
# 1. Azure Portal → Microsoft Entra ID → App registrations → New registration.
#    Copy the Application (client) ID and Directory (tenant) ID.
# 2. Certificates & secrets → New client secret. Copy the secret VALUE.
# 3. API permissions → Microsoft Graph → Application permissions:
#      - Calendars.ReadWrite
#      - OnlineMeetings.ReadWrite.All
#    Click "Grant admin consent".
# 4. For OnlineMeetings.ReadWrite.All scoped to one user, configure an
#    application access policy via PowerShell:
#    https://learn.microsoft.com/graph/cloud-communication-online-meeting-application-access-policy
# 5. MICROSOFT_CALENDAR_USER = mailbox UPN whose calendar will host the event.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALENDAR_USER=info@anytimehire.ai

# Google Calendar + Meet (fallback — used only if MICROSOFT_* vars above are unset)
# 1. Create a service account in Google Cloud, enable Calendar API.
# 2. Either paste the raw JSON key, or base64-encode it.
# 3. Share the target calendar (info@anytimehire.ai's calendar) with the
#    service account email and grant "Make changes to events".
# 4. Set GOOGLE_CALENDAR_ID to the calendar id (typically info@anytimehire.ai).
# 5. In the host account's Meet settings, ensure "Host management" is OFF
#    so guests can join the Meet room without waiting for the host.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=info@anytimehire.ai

# Booking config
BOOKING_TIMEZONE=Asia/Kolkata
BOOKING_BUFFER_MINUTES=15
